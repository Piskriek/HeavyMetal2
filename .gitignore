node_modules/
dist/
tests/artifacts/
*.local
*.zip
scratch/
*.exe
3DTrack/
# T00 safeguard: the certified baseline manifest is evidence and is committed;
# the copied decoration payload next to it is protected data and stays out of Git.
baseline/snapshots/*/*
!baseline/snapshots/*/manifest.json

# Animated spritesheet generator inputs: the raw 1024x1024 sheets the image model
# returned are the irreproducible inputs to the keying pipeline and are committed.
# The *-reference.png 2x2 layout templates next to them are regenerated in seconds
# by scripts/build-anim-reference.mjs and stay out of Git.
art-src/animated/*-reference.png

# Onion-skin alignment overlays are regenerated by scripts/onion-skin-check.mjs
art-src/animated/onion/

# Transient dev-server track prop history backups
backups/props/history/
temp/


# M13: local-only leftovers (planning zips, root screenshots, art-cutting scratch)
archive/
tmp-art/
/p[0-9][0-9].png

# Art review sheets (wave 2 review loop); never committed
art-src/review/

# Local secrets (API keys); never committed
.env.local
*.local.env
