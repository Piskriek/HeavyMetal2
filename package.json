{
  "name": "fidelity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --test packages/triad-369/test/*.test.mjs",
    "triad": "node packages/triad-369/src/cli.mjs",
    "triad:legacy": "node packages/triad-369/src/triad_cli.mjs",
    "triad:status": "node packages/triad-369/src/cli.mjs status",
    "triad:test": "node --test packages/triad-369/test/*.test.mjs",
    "triad:arena": "node packages/triad-369/src/arena_node.mjs",
    "triad:api": "node packages/triad-369/src/api.mjs",
    "triad:serve": "node packages/triad-369/src/serve.mjs",
    "triad:bootstrap": "node packages/triad-369/src/bootstrap.mjs",
    "triad:start": "node packages/triad-369/src/triad_369_process.mjs",
    "triad:bridge": "node packages/triad-369/src/density_bridge.mjs",
    "triad:query": "node packages/triad-369/src/query_triad_369.mjs",
    "fractal-engine": "npm run dev -w @hm/fractal-engine",
    "build": "npm run build -w @hm/fractal-engine",
    "wow:audit": "node packages/triad-369/src/wow_adapter.mjs",
    "anticheat:audit": "node packages/triad-369/src/universal_anticheat.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/three": "^0.186.0",
    "typescript": "5.9.3",
    "vite": "^7.3.2"
  }
}
