+    return true;
+  }
+
+  // ---------- main step ----------
+  /** Advance the simulation by one fixed sub-step (dt in ms). */
+  step(dt: number) {
+    const s = dt / TICK; // fraction of a 60fps tick
+    this.time += dt;
+    if (!this.gateOpen) return;
+    this.syncTrack();
+
+    // item boxes respawn
+    for (const box of this.track.itemBoxes) {
+      const md = meta(box);
