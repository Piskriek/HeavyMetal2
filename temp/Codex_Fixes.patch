+    }
+    m.inventory[item]--;
+    m.itemCooldownUntil = this.time + 450;
+    switch (item) {
+      case 'oil': {
+        this.oils.push({ x: p.x, y: p.y - 10, r: 48, ownerId: m.info.id, expiresAt: this.time + 9000 });
