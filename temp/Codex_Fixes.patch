+          releasedTick: this.currentTick,
+          status: this.currentTick > scheduledTick ? 'delayed' as const : 'released' as const,
+          delayTicks: this.currentTick - scheduledTick,
+          exitSpeed: slot.exitSpeed,
+          x: slot.x,
+          z: slot.z,
+          lane: slot.lane,
+        });
