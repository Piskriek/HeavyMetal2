+test('placement: extracted composition matches the legacy renderer formula exactly', () => {
+  const cases = [
+    { x: 43000, y: courseY(43000, 'ridge') - RADIUS, z: 120, grounded: true },
+    { x: 21000, y: courseY(21000, 'ridge') - 480, z: -300, grounded: false },
