+    // oil expiry
+    this.oils = this.oils.filter((o) => o.expiresAt > this.time);
+
+    // Peggle buckets sweep side to side
+    for (const bk of this.track.buckets) {
+      const md = meta(bk);
+      const x = W / 2 + Math.sin(this.time * 0.0011 + (md.phase ?? 0)) * (W / 2 - 90);
