+
+/* Dialogs and final classification share a high-contrast, keyboard-accessible surface. */
+.dialog-backdrop, .results-backdrop { position: fixed; inset: 0; z-index: 80; display: flex; align-items: center; justify-content: center; padding: 22px; background: #050a12cf; backdrop-filter: blur(8px); animation: backdrop-in .2s ease-out; color: #ecf1f6; }
+.dialog { position: relative; width: 680px; max-width: 100%; max-height: calc(100dvh - 44px); overflow: auto; background: #151d27; border: 1px solid #374555; border-radius: 8px; padding: 34px; box-shadow: 0 20px 100px #0005; }
+.dialog:focus { outline: none; }
