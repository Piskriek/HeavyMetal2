+      status,
+      time: Math.round(time * 1000) / 1000,
+      tick,
+      fieldSize: config.fieldSize,
+      completed,
+      outstanding: participants.length - completed,
+      attemptsTaken,
+      deadlineSeconds,
+      retries: totalAttempts - 1,
+      mysteryEnabled: mysteryOptions.enabled,
+      mysteryRolls: mystery.rolls,
