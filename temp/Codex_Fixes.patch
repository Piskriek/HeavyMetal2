+/**
+ * T07 — collision system public API
+ *
+ * Scalable collision detection with broad-phase spatial hashing,
+ * narrow-phase contact resolution, and separated physics/audio concerns.
+ */
+
+export * from './types';
+export * from './spatial-hash';
+export * from './contacts';
+export * from './cooldowns';
diff --git a/src/game/collision/spatial-hash.ts b/src/game/collision/spatial-hash.ts
