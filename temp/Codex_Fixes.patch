+ *  - engine distance 0 maps D_START units along the spline,
+ *  - engine distance TRACK_DISTANCE maps to distOf('finish') + D_END_RUNOUT.
+ */
+export const D_START = 1100;
+export const D_END_RUNOUT = 350;
