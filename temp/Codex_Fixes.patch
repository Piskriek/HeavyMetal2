+/**
+ * T09 — Physics module exports
+ */
+export {
+  testSweptSphereOBB,
+  testInitialOverlap,
+  resolveWallCollisions,
+  sortContacts,
+  type OBB,
+  type SweptSphere,
+  type WallContact,
