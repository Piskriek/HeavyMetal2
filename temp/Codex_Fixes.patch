+        const dy = sp > 1 ? v.y / sp : 1;
+        const k = 0.6 * s * Math.sqrt(0.8 / b.mass);
+        v = { x: v.x + dx * k * 0.6, y: v.y + Math.max(dy, 0.3) * k };
