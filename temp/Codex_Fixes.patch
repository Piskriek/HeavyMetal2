+  // Lava loops are a section 3 feature and must not become the entry gate.
+  const onlyLava: Obstacle[] = [{ kind: 'lava_loop', x: 5000, width: 380, height: 330, lane: 1, laneSpan: 1, hit: false, hitAt: -100, hitMask: 0 }];
