{
  // Type-checks the test suites and their fixtures, which the app config deliberately excludes.
  // `npm run check` runs this after `tsc --noEmit` over `src`.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Fixtures and generated copies keep the source's shape, including locals the old code left
    // behind once the frame loop was dropped.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node"]
  },
  // Scoped on purpose: the T04 suites and their fixtures are type-checked here. The older suites
  // carry pre-existing type debt from other tickets and are not in this program (see
  // docs/QUALIFYING.md, "Verification").
  "include": [
    "./physics-parity.test.ts",
    "./qualifying-*.test.ts",
    "./fixtures/legacy-engine-sim.ts",
    "./fixtures/modern-engine-sim.ts",
    "./fixtures/parity-harness.ts",
    "./fixtures/qualifying-harness.ts",
    "../src/**/*.ts",
    "../src/**/*.tsx",
    "../src/**/*.json"
  ]
}
