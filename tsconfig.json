{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@hm/contracts": [
        "packages/contracts/src/index.ts"
      ],
      "@hm/kernel": [
        "packages/kernel/src/index.ts"
      ],
      "@hm/script": [
        "packages/script/src/index.ts"
      ],
      "@hm/sim": [
        "packages/sim/src/index.ts"
      ],
      "@hm/platform": [
        "packages/platform/src/index.ts"
      ],
      "@hm/ui": [
        "packages/ui/src/index.ts"
      ],
      "@hm/render": [
        "packages/render/src/index.ts"
      ],
      "@hm/tools": [
        "packages/tools/src/index.ts"
      ],
      "@hm/physics": [
        "packages/physics/src/index.ts"
      ],
      "@hm/engine": [
        "packages/engine/src/index.ts"
      ],
      "@hm/terrain": [
        "packages/terrain/src/index.ts"
      ],
      "@hm/racing": [
        "packages/racing/src/index.ts"
      ],
      "@hm/racers": [
        "packages/racers/src/index.ts"
      ],
      "@hm/trackgen": [
        "packages/trackgen/src/index.ts"
      ],
      "@hm/content": [
        "packages/content/src/index.ts"
      ],
      "@hm/looks": [
        "packages/looks/src/index.ts"
      ],
      "@hm/raceflow": [
        "packages/raceflow/src/index.ts"
      ],
      "@hm/input": [
        "packages/input/src/index.ts"
      ],
      "@hm/goblins": [
        "packages/goblins/src/index.ts"
      ],
      "@hm/game": [
        "packages/game/src/index.ts"
      ],
      "@hm/audio": [
        "packages/audio/src/index.ts"
      ],
      "@hm/trackedit": [
        "packages/trackedit/src/index.ts"
      ],
      "@hm/terrainops": [
        "packages/terrainops/src/index.ts"
      ],
      "@hm/scatter": [
        "packages/scatter/src/index.ts"
      ],
      "@hm/modulation": [
        "packages/modulation/src/index.ts"
      ],
      "@hm/modui": [
        "packages/modui/src/index.ts"
      ],
      "@hm/soundlab": [
        "packages/soundlab/src/index.ts"
      ],
      "@hm/screens": [
        "packages/screens/src/index.ts"
      ],
      "@hm/itemdefs": [
        "packages/itemdefs/src/index.ts"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "packages/*/src",
    "packages/*/tests",
    "apps/*/src",
    "apps/*/vite.config.ts"
  ]
}